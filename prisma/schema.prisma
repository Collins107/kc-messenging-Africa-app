generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  devices        Device[]
  participants   ConversationParticipant[]
  messagesSent   Message[]                 @relation("MessageSender")
  refreshTokens  RefreshToken[]
}

// Backend keys sessions by deviceId, per the frontend's api.ts contract
model Device {
  id           String   @id @default(uuid()) // this IS the deviceId the frontend stores
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken    String?
  platform     String?
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, deviceId])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  body           String?

  messageType    MessageType  @default(TEXT)

  mediaId        String?
  media          Media?       @relation(fields: [mediaId], references: [id])

  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id])

  forwardedFrom  String?

  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deliveredAt    DateTime?

  @@index([conversationId, createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model Media {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  filename   String
  mimeType   String
  size       Int

  storageKey String
  url        String?

  createdAt  DateTime @default(now())

  @@index([ownerId])
}

// Phase 4 additions: Groups, Communities, Channels, Polls, Stories, Business, Products, Orders, Subscriptions

model "Group" {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  group     "Group" @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  mutedUntil DateTime?
  banned    Boolean  @default(false)

  @@unique([groupId, userId])
}

model Community {
  id        String   @id @default(uuid())
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups    "Group"[]
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  type      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poll {
  id        String   @id @default(uuid())
  question  String
  options   Json
  endsAt    DateTime?
  createdBy String
  createdAt DateTime @default(now())
}

model PollVote {
  id       String   @id @default(uuid())
  pollId   String
  userId   String
  choice   Int
  createdAt DateTime @default(now())
}

model Story {
  id        String   @id @default(uuid())
  ownerId   String
  mediaId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
}

model Business {
  id        String   @id @default(uuid())
  ownerId   String
  profile   Json
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id         String   @id @default(uuid())
  businessId String
  title      String
  price      Float
  inventory  Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())
}

model "Order" {
  id        String   @id @default(uuid())
  buyerId   String
  items     Json
  total     Float
  status    String
  createdAt DateTime @default(now())
}

model Subscription {
  id       String   @id @default(uuid())
  userId   String
  planId   String
  status   String
  startedAt DateTime?
  endedAt  DateTime?
}

// Phase 5 foundation additions: SFUSession, Recording, Stream, Organization, Team

model SFUSession {
  id         String   @id @default(uuid())
  roomName   String
  createdBy  String
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  metadata   Json?

  recordings Recording[]
}

model Recording {
  id           String   @id @default(uuid())
  sessionId    String
  session      SFUSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  manifestPath String
  duration     Int?
  size         Int?
  createdAt    DateTime @default(now())
}

model Stream {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  ingestKey String  @unique
  status    String  @default("scheduled")
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
}
