# Postgres connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kc_messaging?schema=public"

# Must match the Vite dev origin the frontend runs on (e.g. http://localhost:5173)
CORS_ORIGIN="http://localhost:5173"

# JWT secrets — rotate these for production
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000

# Set to "true" to log OTP codes to the console instead of sending real SMS (dev/sandbox mode)
OTP_DEV_MODE="true"

# Only needed when OTP_DEV_MODE=false
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""
